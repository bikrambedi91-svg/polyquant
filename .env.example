# PolyQuant v3 — Environment Configuration
# Copy to .env and fill in your values.

# Mode
MODE=paper  # paper or live

# Bankroll
BANKROLL_USDC=10000

# Binance (required for price data)
BINANCE_API_KEY=
BINANCE_API_SECRET=

# CryptoQuant (optional — on-chain data)
CRYPTOQUANT_API_KEY=

# Deribit (optional — vol surface data)
DERIBIT_CLIENT_ID=
DERIBIT_CLIENT_SECRET=

# Polymarket (required for live trading)
POLY_PRIVATE_KEY=
POLY_FUNDER_ADDRESS=
POLY_SIGNATURE_TYPE=1
POLY_CHAIN_ID=137

# Risk Parameters
MAX_SINGLE_POSITION_PCT=0.12
MAX_PER_ASSET_PCT=0.25
MAX_TOTAL_EXPOSURE_PCT=0.60
DAILY_DRAWDOWN_HALT_PCT=0.08
MIN_POSITION_USD=50
MIN_EDGE_THRESHOLD=0.08
MIN_CONFIDENCE=55
KELLY_FRACTION_DEFAULT=0.25

# TP/SL Defaults (overridden by learned values once enough data)
TP_OFFSET_DEFAULT=0.05
SL_5M=0.08
SL_15M=0.10
SL_1H=0.12
SL_4H=0.15
TIME_DECAY_EXIT_PCT=0.15
TIME_DECAY_FORCE_EXIT_PCT=0.05

# Learning Engine
LEARNING_ENABLED=true
RECALIBRATION_TRADE_INTERVAL=50
RECALIBRATION_TIME_INTERVAL_HOURS=168
MIN_TRADES_FOR_SL_OPTIMIZATION=30
MIN_TRADES_FOR_PARAM_MUTATION=80
MIN_SHADOW_TRADES=30
MAX_PARAM_CHANGE_PCT=0.50
OPTUNA_QUICK_TRIALS=50
OPTUNA_DEEP_TRIALS=200
BRIER_WARNING_THRESHOLD=0.28
BRIER_CRITICAL_THRESHOLD=0.35
MAX_ENSEMBLE_MODELS=8

# Database
DB_URL=sqlite:///polyquant.db

# Alerts (optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_WEBHOOK_URL=

# Dashboard
STREAMLIT_PORT=8501
DASHBOARD_REFRESH_SECONDS=10

# Graduation
MIN_PAPER_TRADES=100
MIN_PAPER_WIN_RATE=0.54
MIN_PAPER_SHARPE=0.8
MAX_CALIBRATION_ERROR=0.15
MIN_PAPER_DAYS=14
MIN_RECALIBRATION_CYCLES=2
